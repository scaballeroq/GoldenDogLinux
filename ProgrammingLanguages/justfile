# ProgrammingLanguages Sub-Justfile - Debian Workstation (KDE Plasma 6)

# Instalar todos los lenguajes y runtimes
languages: mise node python rust java
    @echo "✅ Todos los lenguajes han sido instalados correctamente."

# Diagnóstico de todos los lenguajes y runtimes
languages-status:
    ./mise.sh --status
    ./nodejs.sh --status
    ./python.sh --status
    ./rust.sh --status
    ./java.sh --status

# Gestor de versiones Mise
mise *args:
    ./mise.sh {{args}}

# Node.js LTS & pnpm vía Mise
node *args:
    ./nodejs.sh {{args}}

# Python nativo (Debian) con UV package manager
python *args:
    ./python.sh {{args}}

# Inicializador de proyectos Python con UV
python-uv *args:
    ./python-uv-init.sh {{args}}

# Rust toolchain (Rustup + Mold + sccache)
rust *args:
    ./rust.sh {{args}}

# OpenJDK Java LTS (Maven + Gradle)
java *args:
    ./java.sh {{args}}
